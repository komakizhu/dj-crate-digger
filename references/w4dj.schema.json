{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/komakizhu/dj-crate-digger/blob/main/references/w4dj.schema.json",
  "title": "DJ Crate Digger W4DJ v2 handoff",
  "description": "Minimal UTF-8 recommendation handoff. Version 1 and unknown fields are rejected; no migration is performed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "export_id",
    "playlist",
    "tracks"
  ],
  "properties": {
    "format": {
      "const": "w4dj"
    },
    "format_version": {
      "const": 2
    },
    "export_id": {
      "type": "string",
      "minLength": 1
    },
    "playlist": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/track"
      }
    }
  },
  "$defs": {
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "title",
        "artist_display"
      ],
      "properties": {
        "position": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Complete official track title; Remix, Edit, Live, Dub, Instrumental, Radio Edit, Extended Mix and other official qualifiers remain embedded here."
        },
        "artist_display": {
          "type": "string",
          "minLength": 1
        },
        "netease_track_id": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": [
              "unknown",
              "null",
              "none",
              "undefined"
            ]
          },
          "description": "Optional NetEase Cloud Music identity. It must remain a JSON string, including for large numeric-looking IDs."
        }
      }
    }
  }
}
